<Window x:Class="ScaleTrainer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scale Trainer"
        Height="700" Width="960"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Scale Trainer main window">

  <!-- Keyboard shortcuts -->
  <Window.InputBindings>
    <KeyBinding Key="F1" Command="{Binding ShowAboutCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SpeakScaleCommand}"/>
    <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshMidiDevicesCommand}"/>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding ToggleSpeakFeedbackCommand}"/>
  </Window.InputBindings>

  <DockPanel>

    <!-- Menu bar for accessibility and discoverability -->
    <Menu DockPanel.Dock="Top" AutomationProperties.Name="Main menu">
      <MenuItem Header="_Help">
        <MenuItem Header="_About / Help" Command="{Binding ShowAboutCommand}"
                  InputGestureText="F1"
                  AutomationProperties.Name="About and Help"
                  AutomationProperties.AutomationId="MenuAbout"/>
      </MenuItem>
    </Menu>

    <!-- Top toolbar -->
    <Border DockPanel.Dock="Top" Padding="16,12"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
      <StackPanel>
        <!-- Row 1: Scale + Root + Speak + Help -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="Scale:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Width="200"
                    ItemsSource="{Binding AvailableScales}"
                    SelectedItem="{Binding SelectedScale}"
                    DisplayMemberPath="Name"
                    AutomationProperties.Name="Scale"
                    AutomationProperties.HelpText="Choose the musical scale to practice"
                    AutomationProperties.AutomationId="ScaleSelector"
                    Margin="0,0,20,0"/>

          <TextBlock Text="Root:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Width="90"
                    ItemsSource="{Binding AvailableRoots}"
                    SelectedItem="{Binding SelectedRoot}"
                    DisplayMemberPath="DisplayName"
                    AutomationProperties.Name="Root note"
                    AutomationProperties.HelpText="Choose the root note of the scale"
                    AutomationProperties.AutomationId="RootSelector"
                    Margin="0,0,20,0"/>

          <Button Content="Speak Scale"
                  Command="{Binding SpeakScaleCommand}"
                  Padding="14,5"
                  ToolTip="Ctrl+S"
                  AutomationProperties.Name="Speak scale"
                  AutomationProperties.HelpText="Recite all notes of the current scale using text-to-speech. Shortcut: Ctrl+S"
                  AutomationProperties.AutomationId="SpeakScaleButton"
                  Margin="0,0,12,0"/>

          <CheckBox Content="Speak feedback"
                    IsChecked="{Binding SpeakFeedbackEnabled}"
                    VerticalAlignment="Center"
                    ToolTip="Ctrl+F"
                    AutomationProperties.Name="Speak feedback"
                    AutomationProperties.HelpText="When checked, correct and wrong notes are announced by voice. Shortcut: Ctrl+F"
                    AutomationProperties.AutomationId="SpeakFeedbackCheckbox"
                    Margin="0,0,16,0"/>

          <Button Content="Help"
                  Command="{Binding ShowAboutCommand}"
                  Padding="14,5"
                  ToolTip="F1"
                  AutomationProperties.Name="Help"
                  AutomationProperties.HelpText="Open the About and Help window. Shortcut: F1"
                  AutomationProperties.AutomationId="HelpButton"/>
        </StackPanel>

        <!-- Row 2: MIDI device -->
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="MIDI Input:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Width="260"
                    ItemsSource="{Binding AvailableMidiDevices}"
                    SelectedItem="{Binding SelectedMidiDevice}"
                    DisplayMemberPath="Name"
                    AutomationProperties.Name="MIDI input device"
                    AutomationProperties.HelpText="Select the MIDI keyboard or controller"
                    AutomationProperties.AutomationId="MidiDeviceSelector"
                    Margin="0,0,12,0"/>

          <Button Content="Refresh"
                  Command="{Binding RefreshMidiDevicesCommand}"
                  Padding="12,5"
                  ToolTip="Ctrl+R"
                  AutomationProperties.Name="Refresh MIDI devices"
                  AutomationProperties.HelpText="Refresh the list of MIDI devices. Shortcut: Ctrl+R"
                  AutomationProperties.AutomationId="RefreshMidiButton"
                  Margin="0,0,16,0"/>

          <TextBlock VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     AutomationProperties.Name="MIDI connection status">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="Not connected"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMidiConnected}" Value="True">
                    <Setter Property="Text" Value="Connected"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Status live region (kept for screen readers) -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
            Padding="16,10"
            AutomationProperties.LiveSetting="Assertive">
      <StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   FontSize="15"
                   AutomationProperties.Name="Status"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.AutomationId="StatusLiveRegion"/>
        <TextBlock Margin="0,4,0,0"
                   FontSize="13"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   AutomationProperties.Name="Last played note">
          <Run Text="Last note: "/>
          <Run Text="{Binding LastPlayedNote}" FontWeight="SemiBold"/>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Scale notes display -->
    <GroupBox Header="Notes in the selected scale"
              Margin="16"
              Padding="8"
              AutomationProperties.Name="Current scale notes group">
      <ListBox ItemsSource="{Binding CurrentScaleNotes}"
               FontSize="22"
               FontWeight="SemiBold"
               Padding="8"
               AutomationProperties.Name="Notes in the selected scale"
               AutomationProperties.AutomationId="ScaleNotesList"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Content" Value="{Binding Name}"/>

            <Style.Triggers>
              <!-- Correct note – green (still readable in most high-contrast themes) -->
              <DataTrigger Binding="{Binding WasCorrect}" Value="True">
                <Setter Property="Background" Value="#C8E6C9"/>
                <Setter Property="BorderBrush" Value="#2E7D32"/>
                <Setter Property="Foreground" Value="#1B5E20"/>
              </DataTrigger>

              <!-- Wrong note highlight -->
              <DataTrigger Binding="{Binding WasCorrect}" Value="False">
                <Setter Property="Background" Value="#FFCDD2"/>
                <Setter Property="BorderBrush" Value="#C62828"/>
                <Setter Property="Foreground" Value="#B71C1C"/>
              </DataTrigger>

              <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="FontWeight" Value="Bold"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
    </GroupBox>

  </DockPanel>
</Window>
