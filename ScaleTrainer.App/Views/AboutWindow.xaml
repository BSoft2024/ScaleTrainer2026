<Window x:Class="ScaleTrainer.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Scale Trainer"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AutomationProperties.Name="About Scale Trainer">

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Close" Width="90" IsDefault="True" IsCancel="True"
              Click="Close_Click"
              AutomationProperties.Name="Close"
              AutomationProperties.AutomationId="AboutCloseButton"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Scale Trainer" FontSize="22" FontWeight="Bold"
                   AutomationProperties.Name="Application name"/>
        <TextBlock Text="Version 1.0" Margin="0,4,0,12"
                   AutomationProperties.Name="Version"/>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="A Windows application that helps you learn musical scales using a MIDI keyboard. Play notes and receive immediate visual, audio, and spoken feedback."/>

        <TextBlock Text="How to use" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,6"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="1. Connect your MIDI keyboard and select it from the list if needed."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="2. Choose a scale and a root note."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="3. Play notes on your keyboard. Correct notes play normally; wrong notes also trigger an error tone."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="4. Use 'Speak Scale' to hear the notes of the current scale recited."/>

        <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,6"/>
        <TextBlock Text="F1 – Open this Help / About window"/>
        <TextBlock Text="Ctrl+S – Speak the current scale"/>
        <TextBlock Text="Ctrl+R – Refresh MIDI devices"/>
        <TextBlock Text="Ctrl+F – Toggle spoken feedback on/off"/>
        <TextBlock Text="Esc – Close this dialog"/>

        <TextBlock Text="Accessibility" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,6"/>
        <TextBlock TextWrapping="Wrap"
                   Text="Scale Trainer is designed to work with screen readers (NVDA, Narrator, JAWS). Status messages are announced via a live region, and all controls have accessible names. Spoken feedback can be turned on or off."/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
